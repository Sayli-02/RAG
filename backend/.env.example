PROJECT_NAME=FinScope
ENVIRONMENT=development
API_V1_STR=/api/v1

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finscope
# Hosted Postgres (Supabase session pooler). When this is set, the POSTGRES_* fields above are ignored.
# Copy the session-mode URI (port 5432) and use the postgresql+psycopg2 scheme.
# SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Comma-separated sites allowed to call the API. Add the Vercel URL when you deploy.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Vector Configuration
VECTOR_DIMENSION=384
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_UPLOAD_BYTES=20971520

# Auth. Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=60

# Gemini. Leave the key blank until you are ready to ask a question.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

